    <string name="media_proxy_keep_awake_title">Keep Wi-Fi and CPU awake</string>
    <string name="media_proxy_keep_awake_description">Avoids interruptions with the screen off while serving other devices. Uses a little more battery</string>

    <string name="media_proxy_section_requests">Requests</string>
    <string name="media_proxy_user_agent_title">Default User-Agent</string>
    <string name="media_proxy_user_agent_description">Sent to servers when the stream doesn\'t set one. Some servers block unknown players</string>
    <string name="media_proxy_user_agent_default">Built-in</string>
    <string name="media_proxy_user_agent_hint">Empty to use the built-in one. The headers of the stream always take priority.</string>
