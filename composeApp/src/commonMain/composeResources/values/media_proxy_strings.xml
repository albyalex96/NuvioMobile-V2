    <string name="media_proxy_cors_title">CORS headers</string>
    <string name="media_proxy_cors_description">Needed by web players such as the Chromecast for HLS/DASH streams. Turn off only for testing</string>
    <string name="media_proxy_rewrite_title">Rewrite HLS/DASH playlists</string>
    <string name="media_proxy_rewrite_description">Segments and keys also go through the proxy with the same headers. Turn off only for testing</string>

    <string name="media_proxy_section_cast">Chromecast</string>
    <string name="media_proxy_cast_always_title">Always cast through the proxy</string>
    <string name="media_proxy_cast_always_description">Every stream passes through this device, not only the ones that need it. Useful when a server refuses the Chromecast; this device must stay on the network</string>
    <string name="media_proxy_cast_fallback_title">Automatic fallback for HLS/DASH</string>
    <string name="media_proxy_cast_fallback_description">If the Chromecast can\'t load an adaptive stream directly, retry once through the proxy</string>

