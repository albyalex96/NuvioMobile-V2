    <string name="skipdb_send_duration">Send stream duration</string>
    <string name="skipdb_send_duration_description">Lets SkipDB match or shift the timestamps to the exact release being played. The lookup waits until the player knows the duration.</string>
    <string name="skipdb_ignore_out_of_range">Ignore unreliable matches</string>
    <string name="skipdb_ignore_out_of_range_description">Skip timestamps recorded on a release whose length differs too much from the one being played.</string>
    <string name="skipdb_min_confidence">Minimum confidence</string>
    <string name="skipdb_min_confidence_description">Ignore segments with a lower confidence. SkipDB computes it from matching submissions and community votes.</string>
    <string name="skipdb_adjust_mode">Adjustment mode</string>
    <string name="skipdb_adjust_mode_description">How SkipDB shifts timestamps recorded on a release of a different length.</string>
    <string name="skipdb_adjust_conservative">Conservative</string>
    <string name="skipdb_adjust_conservative_description">Shifts timestamps only when the difference is reliable (default).</string>
    <string name="skipdb_adjust_greedy">Aggressive</string>
    <string name="skipdb_adjust_greedy_description">Shifts timestamps even when the match is less certain.</string>
    <string name="skipdb_adjust_none">None</string>
    <string name="skipdb_adjust_none_description">Never shifts: timestamps are used as recorded.</string>
    <string name="skipdb_submit_enabled">Enable SkipDB submission</string>
    <string name="skipdb_submit_enabled_description">Lets you send timestamps from the player to SkipDB. Requires an API key.</string>
