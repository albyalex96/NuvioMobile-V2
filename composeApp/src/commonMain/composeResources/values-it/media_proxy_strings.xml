    <string name="settings_advanced_section_network">Rete</string>
    <string name="media_proxy_title">Proxy multimediale</string>
    <string name="media_proxy_entry_description">Server locale che serve flussi P2P, download e link con header ad altri dispositivi, come il Chromecast</string>

    <string name="media_proxy_section_status">Stato</string>
    <string name="media_proxy_status_server">Server</string>
    <string name="media_proxy_status_running">Attivo</string>
    <string name="media_proxy_status_idle">Inattivo (parte quando serve)</string>
    <string name="media_proxy_status_address">Indirizzo di rete</string>
    <string name="media_proxy_status_no_network">Nessuna rete locale</string>
    <string name="media_proxy_status_manual_address">%1$s (manuale)</string>
    <string name="media_proxy_status_port">Porta</string>
    <string name="media_proxy_status_sources">Flussi attivi</string>
